# Copia questo file in "keystore.properties" (nella root del progetto)
# e compila i valori. NON committare keystore.properties né il file .jks.
#
# Per generare il keystore:
#   keytool -genkeypair -v -keystore release.jks -alias gpsphoto \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile è relativo alla root del progetto.
storeFile=release.jks
storePassword=LA_TUA_PASSWORD_STORE
keyAlias=gpsphoto
keyPassword=LA_TUA_PASSWORD_KEY
